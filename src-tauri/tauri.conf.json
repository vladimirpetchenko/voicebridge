{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceBridge",
  "version": "0.1.2",
  "identifier": "com.voicebridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceBridge",
        "label": "main",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Голосовой ассистент для разработчиков",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNDI3RDUyOEY4NUJDQjAKUldTd3ZJV1BVbjFDZ2o3aUFoZlZ3enFZbHNqNHN2UmNETWpkVURKbFpITXMzdmFIb1dUVzh4cVQK",
      "endpoints": [
        "https://github.com/vladimirpetchenko/voicebridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
